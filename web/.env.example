# Names only. Real values live in Vercel (production) or a local .env.local that is never committed.
ACCOUNTS_API_URL=https://accounts-api.example.up.railway.app
ACCOUNTS_API_TOKEN=            # accounts-web automation token (empire-automations provision, 30 days)
ACCOUNTS_WEB_FIELD_KEY=        # 32 random bytes, base64url; encrypts email addresses. Losing it loses them.
ACCOUNTS_WEB_PUBLIC_ORIGIN=https://accounts.example.com
ACCOUNTS_WEB_PREVIEW_ORIGINS=
ACCOUNTS_WEB_OIDC_ISSUER=https://accounts.google.com
ACCOUNTS_WEB_OIDC_CLIENT_ID=
ACCOUNTS_WEB_OIDC_CLIENT_SECRET=
ACCOUNTS_WEB_OWNER_SUBJECTS={"email:<your verified email>":"owner"}   # or {"<oidc sub>":"owner"}; exactly one entry
ACCOUNTS_WEB_SESSION_KEY=      # 32 random bytes, base64url
ACCOUNTS_WEB_SESSION_GENERATION=1   # bump and redeploy to sign every browser out
# Local only, never in production: skip sign-in on http://127.0.0.1:3623
ACCOUNTS_WEB_LOCAL_DEMO=false
