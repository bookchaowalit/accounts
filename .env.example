# Runtime-only configuration. Replace placeholders; do not store credentials.
ACCOUNTS_API_HOST=0.0.0.0
ACCOUNTS_API_ENV=production
# PORT is assigned by the PaaS; optional ACCOUNTS_API_PORT overrides it.
ACCOUNTS_API_MATRIX_PATH=/app/accounts/ACCOUNT-MATRIX.yaml
ACCOUNTS_API_AUTH_ISSUER=https://solo-web.example
ACCOUNTS_API_AUTH_PUBLIC_KEY=REPLACE_WITH_PEM_RSA_PUBLIC_KEY
ACCOUNTS_API_AUTH_SUBJECTS=REPLACE_WITH_ALLOWED_OIDC_OWNER_SUBJECT
ACCOUNTS_API_CORS_ORIGINS=https://solo-web.example
